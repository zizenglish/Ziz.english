<script>
const voicesReady = () => new Promise(resolve=>{
 if(!('speechSynthesis' in window)){resolve([]);return}
 let v=speechSynthesis.getVoices(); if(v.length){resolve(v);return}
 speechSynthesis.onvoiceschanged=()=>resolve(speechSynthesis.getVoices());
 setTimeout(()=>resolve(speechSynthesis.getVoices()),1200);
});
function pickVoice(kind){
 const voices=speechSynthesis.getVoices().filter(v=>/^en(-|_)/i.test(v.lang));
 if(!voices.length)return null;
 const female=/female|woman|samantha|victoria|karen|moira|tessa|zira|aria|jenny|libby|sonia|serena/i;
 const male=/male|man|daniel|david|george|james|guy|ryan|oliver|arthur|fred/i;
 const rx=kind==='female'?female:male;
 return voices.find(v=>rx.test(v.name))||voices.find(v=>/en-GB/i.test(v.lang))||voices[0];
}
function say(text,kind='female',rate=0.88,pitch=1){
 if(!text||!('speechSynthesis'in window)){return}
 speechSynthesis.cancel();
 const u=new SpeechSynthesisUtterance(text);u.lang='en-GB';u.rate=rate;u.pitch=pitch;
 const v=pickVoice(kind);if(v)u.voice=v;speechSynthesis.speak(u);
}
function stopSpeech(){if('speechSynthesis'in window)speechSynthesis.cancel()}
const shopLines=[
 ['assistant','Hello! Welcome to the shop. Can I help you?'],
 ['customer','Yes, please. How much is that T-shirt?'],
 ['assistant',"It's twelve pounds."],
 ['customer',"Oh, that's a little expensive. How much is this key ring?"],
 ['assistant',"It's four pounds."],
 ['customer',"Great. And how much is that mug?"],
 ['assistant',"It's six pounds."],
 ['customer',"I'll take the key ring, please."],
 ['assistant',"Of course. Here you are."],
 ['customer',"Thank you. Goodbye!"]
];
async function playShopDialogue(slow=false){
 if(!('speechSynthesis'in window)){alert('Your browser does not support speech audio.');return}
 speechSynthesis.cancel();await voicesReady();
 for(const [who,text] of shopLines){
  await new Promise(resolve=>{
   const u=new SpeechSynthesisUtterance(text);u.lang='en-GB';u.rate=slow?.72:.91;u.pitch=who==='customer'?1.14:.88;
   const v=pickVoice(who==='customer'?'female':'male');if(v)u.voice=v;
   u.onend=resolve;u.onerror=resolve;speechSynthesis.speak(u);
  });
 }
}
function clearInputs(ids){ids.forEach(id=>document.getElementById(id).value='');}
const norm=s=>s.toLowerCase().replace(/[^a-z0-9 ]/g,'').trim().replace(/\s+/g,' ');
const memoryAnswers=['cap','football scarf','football shirt','key ring','mug','plate','teddy','t shirt'];
function checkMemory(){
 const ids=['m2a','m2b','m2c','m2d','m2e','m2f','m2g','m2h'];let n=0;
 ids.forEach((id,i)=>{const ok=norm(document.getElementById(id).value)===norm(memoryAnswers[i]);if(ok)n++;});
 const fb=document.getElementById('m2fb');fb.textContent=`You remembered ${n} / 8. ${n===8?'Fantastic memory!':'Check the vocabulary and try again.'}`;fb.className='feedback '+(n===8?'correct':'wrong');
}
function checkPrices(){
 const a=['price1','price2','price3'].map(id=>document.getElementById(id).value);
 const ok=[12,4,6];let n=a.filter((v,i)=>Number(v)===ok[i]).length;
 const fb=document.getElementById('pricefb');fb.textContent=`You got ${n} / 3 prices correct. Answers: £12, £4, £6.`;fb.className='feedback '+(n===3?'correct':'wrong');
}
function chooseBuy(btn,val){document.querySelectorAll('#buyChoices button').forEach(b=>b.classList.remove('choice','active'));btn.classList.add('choice','active');const fb=document.getElementById('buyfb');fb.textContent=val==='key ring'?'Correct! She buys the key ring.':'Not quite. Listen again: what does she choose?';fb.className='feedback '+(val==='key ring'?'correct':'wrong');}
function checkGallery(){
 const ids=['g5a','g5b','g5c','g5d'],ans=['magnet','postcard','bracelet','miniature'];let n=ids.filter((id,i)=>document.getElementById(id).value===ans[i]).length;
 const fb=document.getElementById('g5fb');fb.textContent=`${n} / 4 correct. Answers: magnet, postcard, bracelet, miniature.`;fb.className='feedback '+(n===4?'correct':'wrong');
}
function markChoice(btn,id,val){
 const correct={q1:'This',q2:'Those',q3:'These',q4:'That'}[id];
 btn.parentElement.querySelectorAll('button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');
 const el=document.getElementById(id);el.textContent=val===correct?' ✓ Correct':' ✗ Try again';el.style.color=val===correct?'#32734c':'#a44d48';
}
function checkGrammar(){
 const vals=['b1','b2','b3'].map(id=>document.getElementById(id).value),ans=['this','these','those'];
 const a=vals.filter((v,i)=>v===ans[i]).length;
 const q=['q1','q2','q3','q4'].filter((id)=>document.getElementById(id).textContent.includes('Correct')).length;
 const fb=document.getElementById('grammarfb');fb.textContent=`Mini-dialogue: ${a}/3 correct. Demonstratives quiz: ${q}/4 correct.`;fb.className='feedback '+(a===3&&q===4?'correct':'wrong');
}
function speakFinal(){
 const item=document.getElementById('finalItem').value,price=document.getElementById('finalPrice').value;
 if(!item||!price){document.getElementById('finalModel').textContent='Choose an item and a price first.';return}
 const t=`Hello. How much is this ${item}? It is ${price.replace('£','')} pounds. Great. I'll take it, please.`;
 document.getElementById('finalModel').textContent=t;say(t,'female',.86,1.05);
}
function downloadHomework(){
 const t=document.getElementById('homeworkText').value||'My souvenir postcard homework';
 const blob=new Blob([t],{type:'text/plain'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='my-souvenir-postcard.txt';a.click();URL.revokeObjectURL(a.href);
}
const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){const ids=['m1','m2','m3','m4','m5','m6','final','homework'];const i=ids.indexOf(e.target.id);document.getElementById('progress').style.width=((i+1)/ids.length*100)+'%';}}),{threshold:.25});
document.querySelectorAll('main section').forEach(s=>observer.observe(s));
</script>
